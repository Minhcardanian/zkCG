# Local development only. Use disposable accounts and do not commit populated env files.
DATABASE_URL=postgres://zkcg:local-dev-only@127.0.0.1:55432/zkcg
RPC_URL=http://127.0.0.1:8545
ISSUER_PRIVATE_KEY=
# Alternative to ISSUER_PRIVATE_KEY: encrypted keystore and its password.
# ISSUER_KEYSTORE_PATH=
# ISSUER_KEYSTORE_PASSWORD=
GATE_ADDRESS=
# Optional public frontend default; may be edited in the UI.
VITE_GATE_ADDRESS=
# Comma-separated public wallet addresses permitted to administer issuer records.
ISSUER_WALLET_ADDRESSES=
PORT=3001
# Optional public testnet configuration. Do not put a funded key in a frontend variable.
# SEPOLIA_RPC_URL=
# DEPLOYER_PRIVATE_KEY=
# CONFIRM_SEPOLIA_DEPLOYMENT=yes
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=<public read-only Sepolia RPC URL>
# VITE_START_BLOCK=<Semaphore group creation block>
# SEMAPHORE_START_BLOCK=<Semaphore group creation block>
# Optional explorer verification configuration, using the recorded deployment addresses:
# ETHERSCAN_API_KEY=
# POSEIDON_ADDRESS=
# VERIFIER_ADDRESS=
# SEMAPHORE_ADDRESS=
# ISSUER_ADDRESS=
